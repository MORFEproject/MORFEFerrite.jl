Manifest.toml
/test/Manifest.toml

# Generated example outputs
examples/*/results/
.DS_Store
*/.DS_Store
examples/09_electromechanical/DPIM_EMT3/DPIM_EMT3.7z

# Python bytecode
__pycache__/
*.pyc

# Jupyter checkpoints
.ipynb_checkpoints/

# ── Local developer state — never tracked ────────────────────────────────────
# Claude Code's project state and instruction file.
.claude
CLAUDE.md

# The formatter environment is pinned on purpose, Manifest included, so that everyone
# and CI produce byte-identical formatting. It lives beside the workflow that runs it.
!.github/format/Manifest.toml

# Knowledge graph: regenerated machine state (AST cache, snapshots, HTML).
# Rebuild with `graphify update .`.
graphify-out/

# Scratch notes, plans and analyses: the home for anything written for a
# developer rather than a user, so it never reaches the index by accident.
notes/

# Developer-only documents. Named individually rather than by a blanket *.md,
# which would swallow the READMEs and the reference-data PROVENANCE files.
MIGRATION_PLAN.md
MORFE_API_MIGRATION.md
MODULE_ARCHITECTURE.md
